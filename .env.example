# Copy this file to .env and fill in the values for the platforms you want to use.
#   cp .env.example .env
# A platform with empty values is skipped and reported as "failed: Not configured".
# Never commit the real .env file (it is listed in .gitignore).

# Seconds to wait for each platform API before giving up
REQUEST_TIMEOUT=15

# --- Telegram (bot posting to a channel) ---
# Token from @BotFather; chat id is the public channel name, e.g. @my_channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Discord (channel webhook) ---
# Server Settings > Integrations > Webhooks > New Webhook > Copy Webhook URL
DISCORD_WEBHOOK_URL=

# --- Mastodon ---
# Preferences > Development > New application (scope: write:statuses)
MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# --- Bluesky ---
# Settings > Privacy and security > App passwords (do NOT use your main password)
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# --- GitHub Gist ---
# github.com/settings/tokens > Generate new token (classic) with only the "gist" scope
GITHUB_TOKEN=

# --- DEV Community (dev.to) ---
# dev.to/settings/extensions > Generate API key
DEVTO_API_KEY=
